# Copy to .env for local development. Never commit the real .env.
# All keys are prefixed ELOG_ (see src/core/config.py).

ELOG_ENVIRONMENT=local
ELOG_DEBUG=true

# Auth — local stub issuer until AD FS is wired (Outstanding Items Tracker A-01)
ELOG_AUTH_STUB_ENABLED=true

# Persistence backend: "memory" (default; no server) or "sql" (SQLAlchemy).
ELOG_PERSISTENCE_BACKEND=memory

# MS SQL — local container until the OLNG-managed instance is available (A-04).
# Prod/dev uses the async aioodbc driver (install the `mssql` extra + ODBC Driver 18).
ELOG_DATABASE_URL=mssql+aioodbc://sa:Local_dev_pw1@localhost:1433/elogbook_app?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# For a laptop/CI run with no SQL Server, point at async SQLite instead and let the app
# create the tables from metadata:
#   ELOG_PERSISTENCE_BACKEND=sql
#   ELOG_DATABASE_URL=sqlite+aiosqlite:///./elogbook_local.db
#   ELOG_DB_CREATE_ALL=true

# Valkey (confirmed C17)
ELOG_VALKEY_URL=redis://localhost:6379/0

# ai-service — stub until the ai-service repo is ready
ELOG_AI_SERVICE_STUB_ENABLED=true
ELOG_AI_SERVICE_URL=http://localhost:9000
